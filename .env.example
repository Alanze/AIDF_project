# LLM provider settings
# Use "mock" for a no-key deterministic demo.
# Use "qwen" for Alibaba Cloud Model Studio / DashScope Qwen models.
# Use "openai_compatible" for Ollama, vLLM, LM Studio, or similar APIs.
MODEL_PROVIDER=mock
MODEL_NAME=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-dashscope-api-key

# Backward-compatible aliases. Prefer LLM_BASE_URL and LLM_API_KEY for new setup.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# RAG settings
KNOWLEDGE_BASE_PATH=data/processed/chunks.json
TOP_K=5

# App settings
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
