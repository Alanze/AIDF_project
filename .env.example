# LLM provider settings
# Use "mock" for a no-key deterministic demo, or "openai_compatible" for Ollama/vLLM/LM Studio/OpenAI-compatible APIs.
MODEL_PROVIDER=mock
MODEL_NAME=qwen2.5:7b-instruct
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama

# RAG settings
KNOWLEDGE_BASE_PATH=data/processed/chunks.json
TOP_K=5

# App settings
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
